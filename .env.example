# Copy to .env.local and adjust. Values prefixed NEXT_PUBLIC_ are exposed to the browser.

# Public URL of the deployed site (used for canonical/Open Graph metadata).
NEXT_PUBLIC_SITE_URL=https://elefashionhub.com

# Business WhatsApp number that receives orders, in international format with no "+" or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=2349167593804
